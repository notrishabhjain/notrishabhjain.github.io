---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkRow from '../components/WorkRow.astro';
import ParallelApproval from '../components/diagrams/ParallelApproval.astro';
import { person, meta, hero, proof, engagements, contact } from '../data/site';

const cases = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const featured = cases.slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: person.role,
  description: meta.description,
  url: Astro.site?.href,
  email: `mailto:${person.email}`,
  sameAs: [person.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'New Delhi', addressCountry: 'IN' },
  worksFor: { '@type': 'Organization', name: 'BDO India' },
  alumniOf: ['Infosys', 'EY', 'UST Global', 'Tata Consultancy Services'].map((n) => ({
    '@type': 'Organization', name: n,
  })),
  knowsAbout: [
    'Programme management', 'Portfolio management', 'Government of India e-governance',
    'Public procurement and RFP authoring', 'Delivery turnaround', 'Agile and Scrum',
    'MERN stack', 'WCAG 2.1 AA and GIGW compliance',
  ],
};
---

<Base jsonLd={jsonLd}>
  <!-- ==================================================== hero -->
  <section class="wrap hero">
    <div class="hero__grid">
      <div>
        <div class="hero__meta">
          <span class="label">{person.role}</span>
          <span class="label" style="color: var(--faint)">/</span>
          <span class="label">{person.location}</span>
        </div>
        <h1 class="hero__headline">{hero.headline}</h1>
      </div>

      <div>
        <p class="hero__standfirst">{hero.standfirst}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/work/">See the work <span class="arrow">&rarr;</span></a>
          <a class="btn btn--ghost" href={person.resumePdf}>Resume</a>
        </div>
        <p style="margin-top: var(--s4)">
          <span class="status"><span class="status__dot" aria-hidden="true"></span>{hero.status}</span>
        </p>
      </div>
    </div>

    <dl class="proof">
      {proof.map((p) => (
        <div class="proof__item">
          <dt class="proof__value">{p.value}{p.unit && <span class="proof__unit"> {p.unit}</span>}</dt>
          <dd class="proof__label">
            {p.label}
            <span class="proof__src">{p.src}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- ==================================================== engagements -->
  <section class="section" id="engagements">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label" style="margin-bottom: var(--s2)">What I'm hired to do</p>
          <h2 class="section-title">Four problems I get handed.</h2>
        </div>
        <p class="section-lede">
          Not a skills inventory. These are the briefs that land on my desk, and the evidence
          that I have closed them before.
        </p>
      </div>

      <div class="engagements">
        {engagements.map((e, i) => (
          <article class="engagement">
            <span class="engagement__n">[{String(i + 1).padStart(2, '0')}]</span>
            <h3 class="engagement__title">{e.title}</h3>
            <p class="engagement__body">{e.body}</p>
            <p class="engagement__proof" set:html={e.proof} />
            <a class="engagement__link" href={e.href}>{e.linkLabel} <span class="arrow">&rarr;</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================================================== the moat, drawn -->
  <section class="section section--alt" id="method">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label" style="margin-bottom: var(--s2)">The part that is hard to copy</p>
          <h2 class="section-title">Anyone can run the build. The approvals are the job.</h2>
        </div>
        <p class="section-lede">
          Public-sector platforms rarely stall on engineering. They stall in a queue nobody
          scheduled. Knowing which queue to join, and when, is most of what I bring.
        </p>
      </div>
      <ParallelApproval />
    </div>
  </section>

  <!-- ==================================================== selected work -->
  <section class="section" id="work">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="label" style="margin-bottom: var(--s2)">Selected work</p>
          <h2 class="section-title">What I have shipped.</h2>
        </div>
        <p class="section-lede">
          Each one written up with the problem, the calls I made, and what changed as a
          result.
        </p>
      </div>

      <div class="work-list">
        {featured.map((entry) => <WorkRow entry={entry} />)}
      </div>

      <p style="margin-top: var(--s4)">
        <a class="btn btn--ghost" href="/work/">All {cases.length} projects <span class="arrow">&rarr;</span></a>
      </p>
    </div>
  </section>

  <!-- ==================================================== contact -->
  <section class="section section--alt" id="contact">
    <div class="wrap">
      <p class="label" style="margin-bottom: var(--s2)">Contact</p>
      <h2 class="contact__heading">{contact.heading}</h2>
      <div class="contact__body">{contact.body.map((p) => <p>{p}</p>)}</div>
      <div class="contact__actions">
        <a class="btn btn--primary" href={`mailto:${person.email}`}>Email me</a>
        <a class="btn btn--ghost" href={person.linkedin}>LinkedIn</a>
        <a class="btn btn--ghost" href="/about/">More about how I work <span class="arrow">&rarr;</span></a>
      </div>
    </div>
  </section>
</Base>
