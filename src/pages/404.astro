---
import Base from '../layouts/Base.astro';
import { person } from '../data/site';
---
<Base title={`Page not found — ${person.name}`} description="That page doesn't exist.">
  <section class="wrap hero">
    <p class="label" style="margin-bottom: var(--s3)">404 — not found</p>
    <h1 class="hero__headline" style="max-width: 16ch">That page doesn't exist.</h1>
    <p class="hero__standfirst">The link is out of date or slightly wrong.</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/work/">See the work</a>
      <a class="btn btn--ghost" href="/">Homepage</a>
    </div>
  </section>
</Base>
