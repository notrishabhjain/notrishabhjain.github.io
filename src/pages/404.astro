---
import Base from '../layouts/Base.astro';
import { person } from '../data/site';
---

<Base title={`Page not found — ${person.name}`} description="That page doesn't exist.">
  <section class="wrap hero">
    <p class="hero__eyebrow">404</p>
    <h1 class="hero__headline" style="max-width: 16ch">That page doesn't exist.</h1>
    <p class="hero__standfirst">
      The link is either out of date or slightly wrong. The work is all on the homepage.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/">Back to the homepage</a>
      <a class="btn btn--ghost" href="/#work">See the work</a>
    </div>
  </section>
</Base>
