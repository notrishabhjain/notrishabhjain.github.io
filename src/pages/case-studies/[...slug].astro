---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { person } from '../../data/site';

export async function getStaticPaths() {
  const cases = (await getCollection('caseStudies')).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return cases.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: cases[(i + 1) % cases.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: d.title,
  about: d.client,
  author: { '@type': 'Person', name: person.name },
  abstract: d.outcome,
};

const facts = [
  { label: 'Client', value: d.client },
  ...(d.via ? [{ label: 'Delivered via', value: d.via }] : []),
  { label: 'My role', value: d.role },
  { label: 'Period', value: d.period },
  { label: 'Status', value: d.status },
];
---

<Base
  title={`${d.short} — ${person.name}`}
  description={d.outcome}
  jsonLd={jsonLd}
>
  <article class="wrap">
    <header class="case-hero">
      <a class="back-link" href="/#work"><span aria-hidden="true">&larr;</span> All work</a>
      <p class="eyebrow" style="margin-bottom: var(--s2)">{d.status} · {d.period}</p>
      <h1 class="case-hero__title">{d.title}</h1>
      <p class="case-hero__outcome">{d.outcome}</p>

      <dl class="factsheet">
        {facts.map((f) => (
          <div>
            <dt class="fact__label">{f.label}</dt>
            <dd class="fact__value" style="margin:0">{f.value}</dd>
          </div>
        ))}
        {d.stack && (
          <div>
            <dt class="fact__label">Stack</dt>
            <dd style="margin:0"><div class="tags">{d.stack.map((s) => <span class="tag">{s}</span>)}</div></dd>
          </div>
        )}
        {d.compliance && (
          <div>
            <dt class="fact__label">Compliance</dt>
            <dd style="margin:0"><div class="tags">{d.compliance.map((s) => <span class="tag">{s}</span>)}</div></dd>
          </div>
        )}
      </dl>
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="next-nav" aria-label="More work">
      <a class="btn btn--ghost" href={`/case-studies/${next.id}/`}>
        Next: {next.data.short} <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a class="btn btn--ghost" href="/#contact">Get in touch</a>
    </nav>
  </article>
</Base>
