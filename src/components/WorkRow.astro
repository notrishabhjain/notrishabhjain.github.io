---
import type { CollectionEntry } from 'astro:content';
interface Props { entry: CollectionEntry<'caseStudies'> }
const { entry } = Astro.props;
const d = entry.data;
---
<a class="work-row" href={`/work/${entry.id}/`}>
  <div class="work-row__metric">
    <span class="work-row__figure">{d.metric.figure}</span>
    <span class="work-row__figure-label">{d.metric.label}</span>
  </div>

  <div>
    <h3 class="work-row__title">{d.short}</h3>
    <p class="work-row__client">{d.client}{d.via ? ` · via ${d.via.split('·')[0].trim()}` : ''} · {d.period}</p>
    <p class="work-row__owned">{d.outcome}</p>
  </div>

  <div class="work-row__side">
    <span class={d.live ? 'pill pill--live' : 'pill'}>{d.status}</span>
    <span class="work-row__cta">Read the case <span class="arrow">&rarr;</span></span>
  </div>
</a>
