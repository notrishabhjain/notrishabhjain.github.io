---
import '../styles/global.css';
import { person, meta, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Structured data injected as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const { title = meta.title, description = meta.description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={person.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/* Applied before first paint so the chosen theme never flashes. */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* Private mode or blocked storage: fall back to the OS preference. */
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand" href="/">{person.name}</a>

        <nav class="site-nav" aria-label="Sections">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>

        <div class="header-actions">
          <button
            class="icon-btn"
            id="theme-toggle"
            type="button"
            aria-label="Switch between light and dark theme"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <a class="btn btn--primary btn--sm" href={person.resumePdf}>Resume</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <span>&copy; {new Date().getFullYear()} {person.name}. Built and maintained by me.</span>
        <span style="margin-left:auto"><a href={person.linkedin} rel="me">LinkedIn</a></span>
        <span><a href={`mailto:${person.email}`}>{person.email}</a></span>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const dark = root.dataset.theme
            ? root.dataset.theme === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          const next = dark ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('theme', next);
          } catch {
            /* Preference just won't persist; the toggle still works this visit. */
          }
        });
      })();
    </script>
  </body>
</html>
